/**
 * Wrangler config for the Excel Capital VRP platform.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (PLAID_SECRET, etc.) are NOT here. Local: .dev.vars. Prod: `wrangler secret put`.
 * NOTE: staging/production currently point at the same D1 id as dev. Create
 * dedicated per-environment D1 databases before go-live (see IMPLEMENTATION-PLAN Stage 5).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "excel-capital-vrp",
	"main": "worker.ts",
	"compatibility_date": "2026-07-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "excel-capital-vrp"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"durable_objects": {
		"bindings": [
			{ "name": "BORROWER_PAYMENT_COORDINATOR", "class_name": "BorrowerPaymentCoordinator" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["BorrowerPaymentCoordinator"] }
	],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "excel-capital-vrp",
			"database_id": "02118551-a7a3-406c-a9ed-786e893ade96",
			"migrations_dir": "migrations"
		}
	],

	// APP_ENV is deliberately NOT "development" here: a bare `wrangler deploy`
	// (no --env) must come up fail-closed, never in dev-auth mode. Local dev gets
	// APP_ENV=development from .dev.vars, which only applies to `wrangler dev`.
	"vars": {
		"PLAID_ENV": "sandbox",
		"APP_ENV": "unset",
		"COLLECTIONS_ENABLED": "false"
	},

	// Daily collection sweep at 06:00 UTC. Guarded server-side: a no-op until
	// schedules exist and (production) the owner has approved go-live.
	"triggers": {
		"crons": ["0 6 * * *"]
	},

	"env": {
		"staging": {
			"name": "excel-capital-vrp-staging",
			"vars": {
				"PLAID_ENV": "sandbox",
				"APP_ENV": "staging",
				"COLLECTIONS_ENABLED": "false",
				"STAFF_BOOTSTRAP_ADMINS": "nudman.yonatan@gmail.com",
				// Automated end-to-end testing only. Maps the "E2E Sandbox Test"
				// Access service token to an operator-role service account, so tests
				// can drive staging without a human one-time PIN. Intentionally
				// absent from the production env below, and src/lib/access.ts
				// refuses this path outright when APP_ENV=production.
				"ACCESS_SERVICE_TOKEN_CN": "fe2d68d9fa57529df430962a8f984970.access",
				"ACCESS_SERVICE_ACCOUNT_EMAIL": "e2e-bot@excel-capital.invalid",
				// Excel Capital testers sign themselves in with any address at this
				// domain and are provisioned as OPERATOR (never admin). Staging only:
				// src/lib/auth.ts refuses domain provisioning when APP_ENV=production,
				// where staff must be added deliberately.
				"STAFF_AUTO_PROVISION_DOMAIN": "excelcapital.co.uk"
			},
			"images": { "binding": "IMAGES" },
			"durable_objects": {
				"bindings": [
					{ "name": "BORROWER_PAYMENT_COORDINATOR", "class_name": "BorrowerPaymentCoordinator" }
				]
			},
			"services": [
				{ "binding": "WORKER_SELF_REFERENCE", "service": "excel-capital-vrp-staging" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "excel-capital-vrp-staging",
					"database_id": "d1f11366-09cf-4eeb-a207-28fc497cd32b",
					"migrations_dir": "migrations"
				}
			],
			"triggers": { "crons": ["0 6 * * *"] }
		},
		"production": {
			"name": "excel-capital-vrp-prod",
			"vars": {
				"PLAID_ENV": "production",
				"APP_ENV": "production",
				"COLLECTIONS_ENABLED": "false",
				"STAFF_BOOTSTRAP_ADMINS": "yonatan@thepipelinegroup.io"
			},
			"images": { "binding": "IMAGES" },
			"durable_objects": {
				"bindings": [
					{ "name": "BORROWER_PAYMENT_COORDINATOR", "class_name": "BorrowerPaymentCoordinator" }
				]
			},
			"services": [
				{ "binding": "WORKER_SELF_REFERENCE", "service": "excel-capital-vrp-prod" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "excel-capital-vrp-prod",
					"database_id": "21adc836-a680-44af-895d-b7b4edd78cee",
					"migrations_dir": "migrations"
				}
			],
			"triggers": { "crons": ["0 6 * * *"] }
		}
	}
}
