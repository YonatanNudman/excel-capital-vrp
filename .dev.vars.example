# Template for local dev secrets. Copy to `.dev.vars` and fill in real values.
# `.dev.vars` is gitignored. Production uses: wrangler secret put <NAME>

# --- Cloudflare (personal account) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- R2 (S3-compatible) — optional, only for document storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# --- Plaid (UK Payment Initiation / VRP) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=

# --- App ---
APP_BASE_URL=http://localhost:8787
SETUP_LINK_SIGNING_SECRET=

# --- Encryption ---
APP_ENCRYPTION_KEY=
CRON_SECRET=
