# Template for local dev secrets. Copy to `.dev.vars` and fill in real values.
# `.dev.vars` is gitignored. Production uses: wrangler secret put <NAME>

# --- Cloudflare (personal account) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- R2 (S3-compatible) — optional, only for document storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# --- Plaid (UK Payment Initiation / VRP) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=

# --- App ---
APP_BASE_URL=http://localhost:8787
SETUP_LINK_SIGNING_SECRET=

# --- Encryption ---
APP_ENCRYPTION_KEY=
CRON_SECRET=

# --- Cloudflare Access (required in deployed envs; blank for local dev) ---
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
STAFF_BOOTSTRAP_ADMINS=

# --- Email (blank = log-only mailer; set both to send via Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Plaid VRP consent scope (confirm with Plaid before go-live) ---
PLAID_SCOPE=
